// Гравировка на ЗАДНЕЙ (гладкой) стороне part1 — до 5 горизонтальных строк.
//
// Про переворот: 2D-система здесь — (u, v) = (x, H - z). При взгляде на
// ЗАДНЮЮ грань (проверено контрольным рендером: в этом виде петля уходит
// влево, т.е. экранное "вправо" = +X = +u, а экранное "вверх" = +Z = -v)
// обычный текст читался бы слева направо правильно, но был бы перевёрнут по
// вертикали. Компенсирует это ровно один переворот по v — mirror([0,1,0]).
// Поворот на 180° здесь НЕ подходит: он даёт зеркальные буквы справа налево
// (проверено рендером, было именно так).
//
// Автоподгон кегля: OpenSCAD не умеет измерять реальную ширину строки, так
// что она оценивается посимвольно — у заглавных, цифр и узких букв ширина
// заметно разная, и грубая оценка "0.6 кегля на символ" врала настолько, что
// строка вроде "HAPPY BIRTHDAY" вылезала за плиту и срезалась обрезкой.
// Таблица ниже (доли от кегля) даёт куда более честную длину. Веб-конфигуратор
// поверх этого измеряет текст по-настоящему и подставляет уже готовый кегль —
// эта оценка нужна тем, кто открывает .scad напрямую или крутит его на
// MakerWorld.
// Доли ОТ ЗНАЧЕНИЯ size, а не от em: в OpenSCAD size — это примерно высота
// заглавной буквы, а em заметно больше (замерено рендером: "HAPPY BIRTHDAY"
// шрифтом Liberation Sans Bold при size=6 занимает 70.9 мм, т.е. 11.8·size).
// Первая версия таблицы считала в долях em и занижала ширину почти на четверть,
// из-за чего автоподгон не срабатывал и длинная строка срезалась обрезкой.
function _cw(c) =
    (c == " " || c == "." || c == "," || c == ":" || c == ";" || c == "'"
     || c == "!" || c == "|" || c == "i" || c == "j" || c == "l") ? 0.39 :
    (c == "I" || c == "t" || c == "f" || c == "r" || c == "(" || c == ")") ? 0.46 :
    (c == "m" || c == "M" || c == "W" || c == "w" || c == "@") ? 1.20 :
    (c >= "A" && c <= "Z") ? 0.97 :
    (c >= "0" && c <= "9") ? 0.77 :
    0.78;
function _strw(s, i = 0) = i >= len(s) ? 0 : _cw(s[i]) + _strw(s, i + 1);

// 8 слотов, а не 5: в веб-конфигураторе поля — это АБЗАЦЫ, длинный абзац
// переносится на следующую строку, так что итоговых строк может быть больше,
// чем введённых полей. Пустые слоты просто игнорируются.
function _used_lines() = [for (s = [text_line1, text_line2, text_line3,
                                    text_line4, text_line5, text_line6,
                                    text_line7, text_line8]) if (len(s) > 0) s];

module text_engrave() {
    lines = _used_lines();
    n = len(lines);
    // ПЛОСКОСТЬ РАЗВЁРНУТА НА 90°. Деталь держат петлёй ВНИЗ, скруглениями
    // вверх — в этом положении строки читаются нормально, слева направо.
    // Значит строка идёт вдоль оси Z детали (её длину ограничивает H), а
    // строки набираются стопкой вдоль оси X (её ограничивает W). Раньше было
    // наоборот: текст развернули, а плиту под ним — нет, и они разъезжались.
    avail_line  = H - 2 * (wall_min + 1.5);   // длина строки
    avail_stack = W - 2 * (wall_min + 1.5);   // высота блока строк
    wmax = n > 0 ? max([for (s = lines) _strw(s)]) : 1;
    icon_res  = icon_type > 0 ? icon_size * 1.25 : 0;
    avail_st2 = avail_stack - icon_res;
    fit_w = wmax > 0 ? avail_line / wmax : text_size;
    fit_h = n > 0 ? avail_st2 / (n * text_line_pitch) : text_size;
    fit   = text_autofit ? min(text_size, fit_w, fit_h) : text_size;
    pitch = fit * text_line_pitch;
    // Экранное "вправо" смотрит по -Z, экранное "вверх" — по +X.
    //
    // ГРАНИЦЫ. Раньше смещения были зажаты только числовым диапазоном
    // ±120 мм, а не краями крышки: текст спокойно уезжал за плиту, и его
    // спасала лишь аварийная обрезка по контуру — то есть буквы просто
    // срезало. Теперь блок упирается в безопасную зону всеми четырьмя
    // сторонами: дотянул до края — дальше не идёт.
    marg = wall_min + 1.5;
    half_line  = wmax * fit / 2;           // половина длины самой длинной строки
    half_stack = n * pitch / 2;            // половина высоты блока строк
    lz_lo = marg + half_line;
    lz_hi = H - marg - half_line;
    sx_lo = p1_x0 + marg + half_stack;
    sx_hi = p1_x1 - marg - half_stack;
    line_z  = min(max(face_cz - text_shift_h, lz_lo), max(lz_lo, lz_hi));
    stack_x = min(max(p1_cx + text_shift_v - icon_res / 2, sx_lo), max(sx_lo, sx_hi));
    ov = 0.3;

    intersection() {
        xz_extrude(-ov, text_depth + ov) {
            union() {
                // mirror([0,1,0]) компенсирует перевёрнутую ось 2D-системы
                // (v = H - z) и взгляд с задней грани; rotate(-90) доворачивает
                // строку в новую ориентацию. Порядок проверен рендером.
                if (n > 0)
                    for (i = [0:n - 1])
                        translate([stack_x + ((n - 1) / 2 - i) * pitch, H - line_z])
                            mirror([0, 1, 0])
                                rotate(-90)
                                    text(lines[i], size = fit, font = text_font,
                                         halign = "center", valign = "center");
                // Иконка — над блоком строк, дальше по +X. Прижимается к той же
                // безопасной зоне, причём по ОБЕИМ осям: раньше держалась только
                // поперечная, и вбок иконка уходила за край.
                // Знак icon_shift_h такой же, как у текста: экранное "вправо"
                // идёт по -Z, поэтому положительный сдвиг уменьшает z.
                if (icon_type > 0)
                    let(ihalf  = icon_size / 2,
                        ix_lo  = p1_x0 + marg + ihalf,
                        ix_hi  = p1_x1 - marg - ihalf,
                        iz_lo  = marg + ihalf,
                        iz_hi  = H - marg - ihalf,
                        ix = min(max(stack_x + half_stack + icon_size * 0.6 + icon_shift_v,
                                     ix_lo), max(ix_lo, ix_hi)),
                        iz = min(max(line_z - icon_shift_h, iz_lo), max(iz_lo, iz_hi)))
                    translate([ix, H - iz])
                        mirror([0, 1, 0])
                            rotate(-90)
                                icon_shape(icon_type, icon_size);
            }
        }
        // страховочная обрезка по контуру детали с отступом в стенку
        xz_extrude(-ov, T + 2 * ov) offset(-wall_min) p1_outline();
    }
}

module part1() {
    union() {
        difference() {
            union() {
                chamfered_plate(edge_chamfer) p1_outline();
                boss();
                p1_knuckle_barrels();
            }
            coin_pocket(p1_cx, lid_depth, pocket_chamfer);
            if (text_enable) text_engrave();
        }
        hinge_pin();
    }
}

// ===========================================================================
// PART 2 — ответная половинка: один бочонок, глубокий карман, вырезы
// ===========================================================================

module p2_knuckle_barrel() {
    translate([0, 0, barrel_z_lo])
        linear_extrude(barrel_z_hi - barrel_z_lo)
            knuckle_barrel_profile(p2_x0, -1);
}

module pin_clearance_hole() {
    translate([knuckle_x, knuckle_y, barrel_z_lo - 1])
        cylinder(r = pin_clear_r, h = (barrel_z_hi - barrel_z_lo) + 2, $fn = 32);
}

// Плоское сечение выреза, ужатое внутрь на d. Через offset() обе формы
// живут в одном коде: круг остаётся кругом, квадрат — скруглённым квадратом,
// и обеим одинаково достаётся скругление дна.
module fn_section(d) {
    if (finger_notch_shape == 0) {
        circle(r = max(fn_r + d, 0.01), $fn = 72);
    } else {
        c = min(finger_notch_corner, fn_r * 0.95);
        side = max(2 * (fn_r - c), 0.02);
        offset(r = max(c + d, 0.01), $fn = 40) square([side, side], center = true);
    }
}

// Вырез под палец: плоское дно, скруглённый переход к стенке, прямая стенка
// до лицевой грани и напуск сквозь неё. Раньше это было тело вращения, и
// форма могла быть только круглой; теперь дно набирается тонкими слоями по
// той же дуге, а сечение берётся из fn_section — поэтому скругление
// одинаково ложится и на круг, и на квадрат.
module finger_notch(z) {
    ov = 2;
    total_d = fn_wall_d + fn_fillet;
    steps = 9;
    translate([p2_cx, T - total_d, z]) rotate([-90, 0, 0]) {
        if (fn_fillet > 0.01) {
            for (i = [0 : steps - 1]) {
                a0 = 90 - i * 90 / steps;
                a1 = 90 - (i + 1) * 90 / steps;
                hull() {
                    translate([0, 0, fn_fillet * (1 - sin(a0))])
                        linear_extrude(0.01) fn_section(-fn_fillet * (1 - cos(a0)));
                    translate([0, 0, fn_fillet * (1 - sin(a1))])
                        linear_extrude(0.01) fn_section(-fn_fillet * (1 - cos(a1)));
                }
            }
        }
        translate([0, 0, fn_fillet])
            linear_extrude(total_d - fn_fillet + ov) fn_section(0);
    }
}

// Монета для наглядности: лежит на дне глубокого кармана. Вызывается только
// с модификатором % — видна в предпросмотре, не попадает ни в рендер, ни в STL.
module coin_dummy() {
    translate([p2_cx, T - base_depth, face_cz])
        rotate([-90, 0, 0])
            cylinder(r = coin_d / 2, h = coin_t, $fn = 96);
}

module part2() {
    difference() {
        union() {
            chamfered_plate(edge_chamfer) p2_outline();
            p2_knuckle_barrel();
        }
        pin_clearance_hole();
        coin_pocket(p2_cx, base_depth, big_pocket_chamfer);
        if (finger_notch_enable) {
            finger_notch(fn_z_lo);
            finger_notch(fn_z_hi);
        }
    }
}

// ===========================================================================
// Вывод
// ===========================================================================

// В режиме "print" обе детали кладутся плашмя на стол (поворот на 90° вокруг
// X переводит толщину Y в высоту над столом) и центрируются по началу
// координат. Петля при этом остаётся сцепленной — шарнир печатается сразу
// собранным. Гравированная сторона part1 при такой раскладке лежит на столе:
// так карманы смотрят вверх и не нуждаются в поддержках, а гравировка
// нормально пропечатывается первым слоем.
module lay_flat() {
    translate([-knuckle_x, H / 2, 0.02])
        rotate([90, 0, 0])
            children();
}

// tint() красит только если цвет задан: color("") в OpenSCAD — ошибка.
module tint(c) { if (c == "") children(); else color(c) children(); }

if (render_part == "part1") {
    tint(lid_color) part1();
} else if (render_part == "part2") {
    tint(base_color) part2();
    if (show_coin) %coin_dummy();
} else if (render_part == "assembly") {
    tint(lid_color) part1();
    tint(base_color) part2();
    if (show_coin) %coin_dummy();
} else {
    lay_flat() {
        tint(lid_color) part1();
        tint(base_color) part2();
        if (show_coin) %coin_dummy();
    }
}
